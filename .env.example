# HomeHub local configuration template

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homehub
POSTGRES_USER=homehub
POSTGRES_PASSWORD=homehub

# Auth placeholders
JWT_AUTHORITY=https://example.auth.region.amazoncognito.com
JWT_AUDIENCE=homehub-api

# Optional service endpoints
WEATHER_SERVICE_URL=http://localhost:5001
TRANSIT_SERVICE_URL=http://localhost:5002
ENERGY_SERVICE_URL=http://localhost:5003
